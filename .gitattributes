# Normaliza finales de línea: los .sh deben llegar a Linux con LF.
* text=auto

*.sh    text eol=lf
*.php   text eol=lf
*.conf  text eol=lf
*.ini   text eol=lf
*.md    text eol=lf
*.ps1   text eol=crlf
*.psm1  text eol=crlf

# Binarios: no tocar
*.zip     binary
*.tar.gz  binary
*.tgz     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.msi     binary
*.mp4     binary
*.rar     binary
*.pdf     binary
*.key     binary
*.crt     binary
