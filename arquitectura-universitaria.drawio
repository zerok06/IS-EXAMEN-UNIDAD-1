        <mxCell id="m1" value="&lt;b style='font-size:15px;'&gt;M1 · Aplicación (guía §6) — PUERTA&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;'&gt;10.10.10.11&lt;/span&gt;&lt;hr&gt;• Apache 2.4.49 + PHP 8.4.26 + WP 7.0.1 + Moodle&lt;br&gt;• Vulns: wp2shell · PHP2Shell · CVE-2021-41773&lt;br&gt;• + config: status / info.php / +Indexes&lt;br&gt;• NFS → M3 · MySQL/Redis → M2&lt;br&gt;&lt;br&gt;&lt;i&gt;Paso 1 aquí, luego pivote al resto&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e3a5f;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;spacingRight=12;fontSize=12;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="500" y="370" width="460" height="260" as="geometry" />
        </mxCell>

        <mxCell id="m6" value="&lt;b style='font-size:15px;'&gt;M6 · Auditor (Kali)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;'&gt;10.10.10.20 · misma LAN&lt;/span&gt;&lt;hr&gt;• Solo ataca M1:80 pre-pivote&lt;br&gt;• M2–M5 le responden filtrado (FW)&lt;br&gt;• Pivota desde M1&lt;br&gt;&lt;br&gt;&lt;i&gt;Disciplina + bitácora&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#5c1a17;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;spacingRight=12;fontSize=12;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="1020" y="380" width="340" height="215" as="geometry" />
        </mxCell>

        <mxCell id="fwrule" value="&lt;b style='font-size:13px;'&gt;Separación lógica&lt;/b&gt;&lt;hr&gt;&lt;span style='font-size:11px;'&gt;• M2–M5 solo aceptan de .11&lt;br&gt;• DNS 53 abierto a la LAN&lt;br&gt;• M6 disciplina: M1:80&lt;br&gt;• Ver guia-R0 §3&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9fafb;strokeColor=#d1d5db;fontColor=#374151;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;spacingRight=12;fontSize=11;arcSize=3;" vertex="1" parent="1">
