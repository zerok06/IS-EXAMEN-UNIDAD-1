        <mxCell id="m5" value="&lt;b style='font-size:15px;'&gt;M5 · Estación (Win10)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;'&gt;10.10.10.15 · FW: solo M1&lt;/span&gt;&lt;hr&gt;• Navegador + SMBv1 + clave débil&lt;br&gt;• VNC :5900 sin clave + soft viejo&lt;br&gt;&lt;br&gt;&lt;i&gt;Paso 5: reúso / EB / VNC&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#5c4a00;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;spacingRight=12;fontSize=12;arcSize=3;" vertex="1" parent="1">
