        <mxCell id="m2" value="&lt;b style='font-size:15px;'&gt;M2 · Base de datos&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;'&gt;10.10.10.12 · FW: solo M1&lt;/span&gt;&lt;hr&gt;• MariaDB + Redis 6.2.6&lt;br&gt;• Vulns: CVE-2022-0543 (10.0) · creds · puertos&lt;br&gt;• + config: SNMP public/private&lt;br&gt;&lt;br&gt;&lt;i&gt;Paso 2: wp-config + Redis RCE&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e4620;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;spacingRight=12;fontSize=12;arcSize=3;" vertex="1" parent="1">
